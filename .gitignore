# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.ruff_cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Data: cache and plots are LOCAL ONLY (never commit) ───────────────────────
data/cache/       # 21cmFAST runtime cache
data/plots/       # rendered figures

# ── Data: products ARE committed (small .npy/.npz) ────────────────────────────
# data/products/  <-- intentionally NOT ignored

# ── Raw simulation outputs (too large) ────────────────────────────────────────
*.h5
*.hdf5
*.fits
*.pkl

# ── HPC job logs ──────────────────────────────────────────────────────────────
*.o[0-9]*
*.e[0-9]*
*.log
logs/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*~

# ── Local config (machine-specific path overrides) ────────────────────────────
configs/local.yaml
