# external/amber_patch/Makefile.ksz  -- [ksz-pipeline] build of patched AMBER
# Same compiler flags as upstream src/Makefile (commit 9703f51), except:
#   - HEALPix/cfitsio include+link lines removed; healpix_stub.o added
#     (maps disabled; see healpix_stub.f90)
#   - MKL flag passed in as MKLFLAG (-qmkl=parallel on newer ifort,
#     -mkl=parallel on older; build_amber.sh detects which)
#   - objects are kept after linking (upstream deletes them)
FC     = ifort
MKLFLAG ?= -qmkl=parallel
FF     = -align -fpp -ftz -g -ip -ipo -O3 -traceback
INTEL  = $(MKLFLAG) -mcmodel=medium -shared-intel
OPENMP = -qopenmp
FLAGS  = $(FF) $(INTEL) $(OPENMP)

OBJ = healpix_stub.o constant.o timing.o mkl.o helper.o input.o \
      sim.o cosmo.o mesh.o esf.o grf.o lpt.o reion.o cmb.o h21cm.o \
      simulation.o cosmology.o meshmake.o esfhalo.o grfmake.o lptmake.o \
      reionization.o cmbreion.o h21cmreion.o

amber.x : $(OBJ)
	$(FC) $(FLAGS) $(OBJ) amber.f90 -o $@

%.o: %.f90
	$(FC) $(FLAGS) -c $*.f90

all : amber.x

clean :
	rm -f *.o *.mod amber.x
