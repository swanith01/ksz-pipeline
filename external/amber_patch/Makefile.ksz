# external/amber_patch/Makefile.ksz  -- [ksz-pipeline] build of patched AMBER
# Same compiler flags as upstream src/Makefile (commit 9703f51), except:
#   - objects are kept after linking (upstream deletes them)
#   - MKL flag passed in as MKLFLAG (-qmkl=parallel on newer ifort,
#     -mkl=parallel on older; build_amber.sh detects which)
#   - HEALPix/cfitsio: if HEALPIX_DIR (built Fortran package, containing
#     lib/libhealpix.a + lib/libsharp.a + include/*.mod) and CFITSIO_DIR
#     (containing libcfitsio.a) are BOTH passed in and found, links the
#     real thing -- AMBER's HEALPix map output (Map=make/write,
#     cl_ksz_healpix.txt) then works. Otherwise falls back to
#     healpix_stub.f90 (see that file): AMBER still builds and every
#     non-map output (power_*.txt, cl_ksz.txt, tau.txt, fields_*.dat --
#     everything this repo's adapter reads) is unaffected; Map=make/write
#     would abort with a clear message instead of silently producing
#     nothing.
FC     = ifort
MKLFLAG ?= -qmkl=parallel
HEALPIX_DIR ?=
CFITSIO_DIR ?=

FF     = -align -fpp -ftz -g -ip -ipo -O3 -traceback
INTEL  = $(MKLFLAG) -mcmodel=medium -shared-intel
OPENMP = -qopenmp

USE_HEALPIX := $(and $(wildcard $(HEALPIX_DIR)/lib/libhealpix.a),$(wildcard $(CFITSIO_DIR)/libcfitsio.a))

ifneq ($(USE_HEALPIX),)
  $(info Linking REAL HEALPix: $(HEALPIX_DIR)  cfitsio: $(CFITSIO_DIR))
  HPXINC  = -I$(HEALPIX_DIR)/include
  # -L$(MKLROOT)/lib/intel64 explicit and FIRST: CFITSIO_DIR (often a conda
  # env's lib/, e.g. anaconda3/lib on TIFR) can itself bundle its own MKL
  # copy (numpy/scipy pull one in) under a DIFFERENT version -- found
  # 2026-09-21: anaconda3/lib/libmkl_intel_lp64.so.1 (MKL 2021.4.0) sitting
  # right next to the cfitsio we actually want, next to oneAPI's own MKL
  # 2022.0.2 (.so.2). Without this, the linker can resolve -lmkl_intel_lp64
  # (added internally by $(MKLFLAG)) against THAT copy instead of oneAPI's,
  # and the resulting amber.x silently runs a different MKL version than
  # the one build_amber.sh reports and the one the validation gate was run
  # against -- no error, just an unlogged numerics-stack substitution.
  # MKLROOT must be exported (build_amber.sh sources setvars.sh first).
  ifeq ($(MKLROOT),)
    $(error MKLROOT is unset -- source setvars.sh before running make)
  endif
  HPXLINK = -L$(MKLROOT)/lib/intel64 -L$(HEALPIX_DIR)/lib -lhealpix -lsharp -L$(CFITSIO_DIR) -lcfitsio
  STUBOBJ =
else
  $(info No HEALPIX_DIR/CFITSIO_DIR given (or libs not found there) -- using healpix_stub.f90; Map=make/write will abort, everything else works)
  HPXINC  =
  HPXLINK =
  STUBOBJ = healpix_stub.o
endif

FLAGS  = $(FF) $(INTEL) $(OPENMP) $(HPXINC)

OBJ = $(STUBOBJ) constant.o timing.o mkl.o helper.o input.o \
      sim.o cosmo.o mesh.o esf.o grf.o lpt.o reion.o cmb.o h21cm.o \
      simulation.o cosmology.o meshmake.o esfhalo.o grfmake.o lptmake.o \
      reionization.o cmbreion.o h21cmreion.o

amber.x : $(OBJ)
	$(FC) $(FLAGS) $(OBJ) amber.f90 $(HPXLINK) -o $@

%.o: %.f90
	$(FC) $(FLAGS) -c $*.f90

all : amber.x

clean :
	rm -f *.o *.mod amber.x
