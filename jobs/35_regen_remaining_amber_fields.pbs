#!/bin/bash
#PBS -N amber_regen_all
#PBS -l nodes=1:ppn=16
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /user1/swanith/ksz-pipeline-amber/jobs/amber_regen_all.log

set -e
cd /user1/swanith/ksz-pipeline-amber
source /apps/intel/oneapi/setvars.sh >/dev/null
source /user1/swanith/miniconda3/etc/profile.d/conda.sh
conda activate p21c_v3
export LD_LIBRARY_PATH="$HOME/Healpix_3.83/lib:/apps/anaconda3/lib:$LD_LIBRARY_PATH"

# Regenerates fields_*.dat for every sweep_chen2023 point whose raw
# snapshots were pruned (confirmed via jobs/34_regen_verify_one_point.pbs:
# re-running amber.x with the preserved input/input.txt reproduces the
# same physics -- tau.txt/cl_tau.txt/cl_kappa.txt byte-identical,
# cl_ksz.txt differs only at the ~1e-7 relative (floating-point roundoff)
# level, four orders of magnitude below our own 1e-3 validation
# threshold). Same seed=1 every point (scripts/40 never overrode it), so
# this reproduces the ALREADY-VALIDATED realization, not a new one.
#
# Idempotent: skips any dir that already has fields_*.dat (so the
# fiducial point already regenerated by the verify job is left alone).
ROOT=runs/sweep_chen2023
cd "$ROOT"
for d in */; do
  d="${d%/}"
  [[ -f "$d/amber_run.json" ]] || continue
  [[ -f "$d/input/input.txt" ]] || { echo "[$d] SKIP -- no input.txt"; continue; }
  nf=$(ls "$d/output/cmb/"fields_*.dat 2>/dev/null | wc -l)
  if [[ "$nf" -gt 0 ]]; then
    echo "[$d] already has $nf field files -- skipping"
    continue
  fi
  echo "[$d] regenerating..."
  ( cd "$d" && ~/amber/src/amber.x < input/input.txt > output/regen_log.txt 2>&1 )
  nf2=$(ls "$d/output/cmb/"fields_*.dat 2>/dev/null | wc -l)
  echo "[$d] done -- $nf2 field files now present"
done

echo
echo "=== final tally ==="
for d in */; do
  d="${d%/}"
  [[ -f "$d/amber_run.json" ]] || continue
  nf=$(ls "$d/output/cmb/"fields_*.dat 2>/dev/null | wc -l)
  echo "$d: $nf field files"
done
