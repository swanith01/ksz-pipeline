#!/bin/bash
#PBS -N amber_stitched_2gpc_norot
#PBS -l nodes=1:ppn=16
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /user1/swanith/ksz-pipeline-amber/jobs/amber_stitched_2gpc_norot.log

set -e
cd /user1/swanith/ksz-pipeline-amber
source /user1/swanith/miniconda3/etc/profile.d/conda.sh
conda activate p21c_v3

# Same as jobs/56 (momentum mode) but with NO wrap-cycle rotation: slabs
# used exactly as stored, no bilinear interpolation. Legitimate here
# because the LOS spans 0.98 box lengths (single wrap cycle). Tests
# whether jobs/56's high-ell deficit vs Limber (0.80 at ell=5000, 0.59
# at 8000) is the smoothing from bilinear rotation onto a generic angle.
# jobs/56 took ~7 min; this should be a little faster (no interpolation).
PYTHONPATH=src python -u scripts/55_amber_stitched_streaming.py \
    --run runs/sweep_2gpc_1536/zmid8_dz4_az3_mh8_mfp3 --mode momentum --no-rotation
