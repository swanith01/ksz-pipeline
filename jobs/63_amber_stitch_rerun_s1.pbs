#!/bin/bash
#PBS -N amber_stitch_s1
#PBS -l nodes=1:ppn=8
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /user1/swanith/ksz-pipeline-amber/jobs/amber_stitch_s1.log

# Stitched flat-sky lightcone (scripts/55, momentum path, no rotation) built from
# the field dumps kept by job 62 (SEED=1, KEEP=1), and its overlay on the native
# D_ell (scripts/61). The in-job version of this step in job 62 hit the 3 h
# walltime at slice 500/552 (the streaming took 12093 s = 3.4 h); this job only
# repeats that step. Ran as job 1759136 (qsub -o jobs/amber_stitch_s1.log ...).
#   qsub -o jobs/amber_stitch_s1.log jobs/63_amber_stitch_rerun_s1.pbs
# Needs runs/native2gpc_s1_fields/output/cmb/fields_*.dat (140 files, ~300 GB).
# Once runs/native2gpc_s1_fields/stitched_streaming_momentum_norot.npz exists the
# fields can be deleted:  rm runs/native2gpc_s1_fields/output/cmb/fields_*.dat

set -e
cd /user1/swanith/ksz-pipeline-amber
source /apps/intel/oneapi/setvars.sh >/dev/null
source /user1/swanith/miniconda3/etc/profile.d/conda.sh
conda activate p21c_v3
export LD_LIBRARY_PATH="$HOME/Healpix_3.83/lib:/apps/anaconda3/lib:$LD_LIBRARY_PATH"
export PYTHONPATH="$PWD/src:${PYTHONPATH:-}"

R=runs/native2gpc_s1_fields
[ "$(ls $R/output/cmb/fields_*.dat | wc -l)" = "140" ] || { echo "fields missing"; exit 1; }
python -u scripts/55_amber_stitched_streaming.py --run "$R" --mode momentum \
    --no-rotation --zmin 4.55 --zmax 18.45 \
    --out data/plots/amber_stitched_vs_limber_2gpc_momentum_norot_native2gpc_s1_fields.png
python -u scripts/61_overlay_native_vs_stitched.py --native-run "$R" \
    --stitched-npz "$R/stitched_streaming_momentum_norot.npz"
