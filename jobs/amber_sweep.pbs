#!/bin/bash
#PBS -N amber_sweep
#PBS -l nodes=1:ppn=16
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /user1/swanith/ksz-pipeline-amber/jobs/amber_sweep.log

set -e
cd /user1/swanith/ksz-pipeline-amber
source /apps/intel/oneapi/setvars.sh >/dev/null
source /user1/swanith/miniconda3/etc/profile.d/conda.sh
conda activate p21c_v3
export OMP_NUM_THREADS=16
export LD_LIBRARY_PATH="$HOME/Healpix_3.83/lib:/apps/anaconda3/lib:$LD_LIBRARY_PATH"

PYTHONPATH=src python scripts/40_run_amber_sweep.py \
    --amber-x ~/amber/src/amber.x --reuse runs/amber_q01 --out-root runs/sweep
