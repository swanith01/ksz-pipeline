#!/bin/bash
# ============================================================
# PBS: kSZ-pipeline stitched-lightcone resolution convergence
# HII_DIM = 32/64/128/256/512 at fixed BOX_LEN=800 Mpc
# NOTE: 512^3 stitched onto a full LOS grid is the heaviest single
# configuration in the whole convergence suite -- density_1plus/
# x_HII_field/v_los_Mpc_s are each (512,512,~1600) float32 arrays,
# multiple GB apiece. Watch memory on the first run.
# ============================================================
#PBS -N ksz_conv_stitched_resolution
#PBS -q workq
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=32:mem=128gb
#PBS -j oe
#PBS -o /user1/swanith/logs/conv_stitched_resolution.log

set -euo pipefail

echo "=============================================="
echo "Job ID       : $PBS_JOBID"
echo "Job name     : $PBS_JOBNAME"
echo "Queue        : $PBS_QUEUE"
echo "Submitted by : $PBS_O_LOGNAME"
echo "Work dir     : $PBS_O_WORKDIR"
echo "Node list    : $(cat $PBS_NODEFILE)"
echo "Start time   : $(date)"
echo "=============================================="

source /user1/swanith/miniconda3/etc/profile.d/conda.sh
conda activate p21c_v3
echo "Python       : $(which python)"
echo "Version      : $(python --version)"
echo "py21cmfast   : $(python -c 'import py21cmfast; print(py21cmfast.__version__)')"
echo "ksz_pipeline : $(python -c 'import ksz_pipeline; print(ksz_pipeline.__file__)')"
echo "----------------------------------------------"

export OMP_NUM_THREADS=32

cd /user1/swanith/ksz-pipeline
mkdir -p /user1/swanith/logs

echo "Starting stitched-lightcone resolution convergence sweep..."
python scripts/05_convergence_stitched.py --sweep resolution --config configs/fiducial.yaml

echo "----------------------------------------------"
echo "End time : $(date)"
echo "Done."
